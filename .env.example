# Copy to .env.local and fill in. Get keys from Cashfree Dashboard → Payment Gateway → Developers → API Keys.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# "production" or "sandbox"
CASHFREE_ENV=production
NEXT_PUBLIC_CASHFREE_ENV=production
# Public site URL used for the payment return link, e.g. https://cupheal.in (must be https in production)
SITE_URL=https://cuplife.in
